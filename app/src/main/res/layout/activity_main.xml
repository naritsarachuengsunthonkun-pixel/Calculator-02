<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE4E1"
    android:orientation="vertical"
    android:padding="16dp">

    <!--หน้าจอแสดงผล-->
    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#FFC0CB"
        android:gravity="end"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="36sp" />

    <!--โซนปุ่ม-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!--แถวที่1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--ปุ่มจิ๋ว-->
            <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#CCFFFF"
                android:textColor="#000066"
                android:textSize="20dp"
                android:text="AC" />

            <Button
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:textSize="20dp"
                android:backgroundTint="#FFCCFF"
                android:text="DEL" />

            <Button
                android:id="@+id/btnMod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:textSize="20dp"
                android:backgroundTint="#CCFFFF"
                android:text="%" />

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:textSize="20dp"
                android:backgroundTint="#FFFFCC"
                android:text="/" />
        </LinearLayout>

        <!--แถวที่2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--ปุ่มจิ๋ว-->
            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFCC"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#CCFFFF"
                android:text="8" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FFCCFF"
                android:text="9" />

            <Button
                android:id="@+id/btnKon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFCC"
                android:text="x" />

        </LinearLayout>

        <!--แถวที่3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--ปุ่มจิ๋ว-->
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:backgroundTint="#FFCCFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:backgroundTint="#FFFFCC"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnHok"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnLob"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="_"
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!--แถวที่4-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--ปุ่มจิ๋ว-->
            <Button
                android:id="@+id/btnOne"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnTwo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:backgroundTint="#FFCCFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnThee"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:backgroundTint="#FFFFCC"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!--แถวที่5-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--ปุ่มจิ๋ว-->
            <Button
                android:id="@+id/btnBL"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+/_"
                android:backgroundTint="#FFFFCC"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnClo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnGod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:backgroundTint="#CCFFFF"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btnTg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textSize="26dp"
                android:backgroundTint="#FFCCFF"
                android:layout_margin="4dp"/>

        </LinearLayout>


    </LinearLayout>


</LinearLayout>